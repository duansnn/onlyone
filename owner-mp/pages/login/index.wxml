<view class="page">
  <view class="hero">
    <view class="shop-name">{{mode === 'login' ? '登录' : '注册'}}</view>
    <view class="intro">日用铺 · 顾客账号</view>
  </view>
  <view class="chips">
    <view class="chip {{mode === 'login' ? 'on' : ''}}" data-mode="login" bindtap="switchMode">登录</view>
    <view class="chip {{mode === 'register' ? 'on' : ''}}" data-mode="register" bindtap="switchMode">注册</view>
  </view>
  <block wx:if="{{mode === 'login'}}">
    <view class="field">
      <view class="label">手机号或账号</view>
      <input value="{{account}}" bindinput="onAccount" placeholder="请输入" />
    </view>
    <view class="field">
      <view class="label">密码</view>
      <input password value="{{password}}" bindinput="onPassword" placeholder="请输入" />
    </view>
  </block>
  <block wx:else>
    <view class="field">
      <view class="label">手机号</view>
      <input type="number" maxlength="11" value="{{mobile}}" bindinput="onMobile" placeholder="用于登录" />
    </view>
    <view class="field">
      <view class="label">密码（至少 6 位）</view>
      <input password value="{{password}}" bindinput="onPassword" placeholder="请输入" />
    </view>
    <view class="field">
      <view class="label">昵称</view>
      <input value="{{nickname}}" maxlength="32" bindinput="onNickname" placeholder="怎么称呼你" />
    </view>
  </block>
  <view class="btn block {{busy ? 'disabled' : ''}}" bindtap="submit">{{mode === 'login' ? '登录' : '注册并登录'}}</view>
  <view class="diag">
    <view class="diag-line">接口：{{apiOrigin}}</view>
    <view class="diag-line err" wx:if="{{lastError}}">上次错误：{{lastError}}</view>
    <view class="diag-line">真机连不上时：右上角 ··· → 开发调试 → 打开调试</view>
  </view>
</view>
