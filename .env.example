# ======================================================================
#  环境变量模板 —— 复制为 .env 后填入真实值：
#      cp .env.example .env          (Git Bash / macOS / Linux)
#      copy .env.example .env        (Windows cmd)
#  .env 已被 .gitignore 排除，不会被提交。
# ======================================================================

### MySQL ###
MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

### Redis ###
REDIS_PASSWORD=change-me

### Druid 监控台 ###
OWNER_DRUID_MONITOR_USERNAME=admin
OWNER_DRUID_MONITOR_PASSWORD=change-me

### 登录令牌密钥（生产务必改成随机长串）###
OWNER_JWT_SECRET=change-me-to-a-long-random-string

### 支付通道（未接商户号时保持 false）###
OWNER_PAY_MOCK_ENABLED=false

### 短信验证码是否随响应回显（仅本地联调，生产必须 false）###
OWNER_SMS_EXPOSE_CODE=false

### 首次启动引导口令 ###
OWNER_BOOTSTRAP_ADMIN_PASSWORD=change-me
OWNER_BOOTSTRAP_OWNER_PASSWORD=change-me
