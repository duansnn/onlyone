# ----------------------------------------------------------------------
# 默认 npm 源在部分网络环境下极慢（实测 registry.npmjs.org 约 16 KB/s，
# 拉取 antd 元数据即可超时），这里改用国内镜像加速安装。
#
# 如果你在海外、或公司要求走私有源，直接删除本文件即可恢复默认源。
# ----------------------------------------------------------------------
registry=https://registry.npmmirror.com
